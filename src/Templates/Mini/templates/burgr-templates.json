{
  "MinimumBurgrVersion": "1.10.0",
  "Description": "ASP.NET Core Minimal API + EF Core in one project, no framework of its own: domain classes, enums, DTOs, DbContext and CRUD endpoints.",
  "Templates": [ "Domain", "Contracts", "Infrastructure", "Api" ],
  "Generators": [
    "SolidOps.Burgr.Essential.Generators.Enums.EnumGenerator, SolidOps.Burgr.Essential",
    "SolidOps.Burgr.Essential.Generators.Objects.ObjectGenerator, SolidOps.Burgr.Essential"
  ],
  "SupportedFeatures": [ "aggregate_roots", "enums", "references", "navigations", "calculated_properties" ],
  "Dependencies": [
    { "Id": "Microsoft.AspNetCore.App", "Version": "10.0" },
    { "Id": "Microsoft.EntityFrameworkCore", "Version": "10.0.*" }
  ],
  "Harness": "harness",
  "Starter": "starter",
  "ProjectFile": "Project.csproj",
  "Tokens": { "ModuleNamespace": "_MODULE_NAMESPACE_", "Module": "_MODULE_", "ModuleSlug": "_MODULE_SLUG_" }
}
