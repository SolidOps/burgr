<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SolidOps.Burgr</AssemblyName>
    <RootNamespace>SolidOps.Burgr</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Generated code must not depend on the machine's culture (Turkish dotless i in
         ToLower, culture-aware comparisons), including in SubZero and third-party generators
         loaded in the process. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon />
    <OutputType>Exe</OutputType>
    <StartupObject>SolidOps.Burgr.Program</StartupObject>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>burgr</ToolCommandName>
    <PackageId>Burgr</PackageId>
    <PackageDescription>A deterministic, model-driven code generator: a YAML model and templates in, source code out. Ships optional AI harnesses for coding agents.</PackageDescription>
    <RepositoryUrl>https://github.com/SolidOps/burgr</RepositoryUrl>
    <PackageProjectUrl>https://solidops.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>burgr;code-generation;source-generator;model-driven;yaml;ddd;dotnet-tool;ai;harness-engineering</PackageTags>
    <Company>Solid Ops</Company>
    <Authors>Damien Lechat</Authors>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Burgr.Core\Burgr.Core.csproj" />
    <ProjectReference Include="..\Burgr.Essential\Burgr.Essential.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
