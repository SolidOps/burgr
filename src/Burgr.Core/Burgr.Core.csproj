<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SolidOps.Burgr.Core</AssemblyName>
    <RootNamespace>SolidOps.Burgr.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Burgr.Core</PackageId>
    <PackageDescription>Core classes available as package for customization</PackageDescription>
    <RepositoryUrl>https://github.com/SolidOps/burgr</RepositoryUrl>
    <PackageProjectUrl>https://solidops.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>burgr;code-generation;source-generator;model-driven;extensibility</PackageTags>
    <Company>Solid Ops</Company>
    <Authors>Damien Lechat</Authors>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SubZero" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
